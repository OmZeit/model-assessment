{
  "project": "example_prediction_audit",
  "output_dir": "outputs/assayready/example_prediction_audit",
  "ingestion": {
    "raw_files": [
      "prediction_audit.csv"
    ],
    "low_n_threshold": 50
  },
  "task": {
    "type": "regression",
    "sequence_col": "sequence",
    "target_col": "measured_expression",
    "prediction_col": "model_prediction",
    "uncertainty_col": "model_uncertainty",
    "id_col": "sequence_id"
  },
  "split": {
    "val_fraction": 0.15,
    "test_fraction": 0.2,
    "group_cols": [
      "batch",
      "construct_family"
    ],
    "homology_threshold": 0.9,
    "homology_k": 8,
    "seed": 13
  },
  "metadata": {
    "categorical_cols": [
      "batch",
      "organism",
      "construct_type",
      "assay"
    ]
  },
  "acquisition": {
    "beta": 1.0,
    "diversity_method": "greedy_embedding_cosine",
    "diversity_penalty": 0.2,
    "top_k": 8
  },
  "evaluation": {
    "schema_version": 1,
    "semantics": {
      "objective_direction": "maximize",
      "units": "measured expression",
      "uncertainty_type": "predictive_standard_deviation"
    },
    "constraints_verified": false,
    "biological_constraints": [
      "respect assay chemistry limits for promoter sequences",
      "preserve construct compatibility constraints"
    ],
    "provenance": {
      "model_identifier": "example_prediction_model",
      "training_independence": "unverified",
      "data_identifier": "prediction_audit.csv",
      "split_identifier": "homology_group_split_v1",
      "code_revision": "public_example_v1",
      "duration_seconds": 0,
      "artifact_verification": "local_checksum_not_provided",
      "dependency_versions": {
        "numpy": "2.x",
        "pandas": "3.x",
        "scikit-learn": "1.x"
      }
    }
  },
  "candidates": {
    "raw_files": [
      "prediction_candidates.csv"
    ]
  }
}
